<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asked only when the BAY65 Assistant first listens; typing and the system voice screen work without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Everywhere Mode (off by default): the orb over other apps, its foreground service and "Ask BAY65"
         notification, and restoring it after a restart. Each is requested only when the user turns it on. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIRELESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" /></intent>
        <intent><action android:name="android.settings.HOME_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DEVICE_INFO_SETTINGS" /></intent>
        <intent><action android:name="com.google.android.intent.action.CONNECT_INPUT" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><category android:name="android.intent.category.OPENABLE" /><data android:mimeType="image/*" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /><category android:name="android.intent.category.OPENABLE" /><data android:mimeType="image/*" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/bay65_icon"
        android:banner="@drawable/bay65_banner" android:theme="@style/NookTheme"
        android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Everywhere Mode panel: opened on request over the current app. Not exported; reached only via
             the alias below, BAY65's own notification, or BAY65 itself. No screenOrientation: a translucent
             activity that fixes its orientation crashes on Android 8.0. -->
        <activity android:name=".AssistantActivity" android:exported="false"
            android:theme="@style/AssistantPanel" android:taskAffinity="" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:label="@string/ask_name"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <!-- "Ask BAY65" in the TV's app list and for "Hey Google, open Ask BAY65". Disabled until the user
             turns on Everywhere Mode; it only opens the panel and accepts no data. -->
        <activity-alias android:name=".AskBay65" android:targetActivity=".AssistantActivity"
            android:exported="true" android:enabled="false" android:label="@string/ask_name"
            android:icon="@drawable/bay65_icon" android:banner="@drawable/bay65_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service android:name=".OrbOverlayService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user-enabled BAY65 Assistant orb over other apps on Android TV and keeps its Ask BAY65 notification available. No microphone, location or media use in this service." />
        </service>
        <service android:name=".RemoteShortcutService" android:exported="true"
            android:label="@string/shortcut_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_shortcut" />
        </service>
        <!-- Optional "Share what I'm watching" (off by default). Holds only the Notification access grant that
             Android requires before it reveals other apps' media sessions (title, artist, playing state). It
             reads no notifications, unbinds as soon as it connects, and never reads screen content. -->
        <service android:name=".NowPlayingService" android:exported="true"
            android:label="@string/now_playing_name" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".EverywhereBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
